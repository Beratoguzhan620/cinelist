{
  "name": "cinelist",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.13.0",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "lucide-react-native": "^1.59.0",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "json-server": "1.0.0-beta.15",
    "playwright": "1.64.1",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api": "node scripts/prepare-db.mjs && json-server server/db.json --host 0.0.0.0 --port 5174 --static server/public",
    "dev": "concurrently -k -n api,expo -c gray,blue \"pnpm api\" \"expo start\"",
    "dev:web": "concurrently -k -n api,expo -c gray,blue \"pnpm api\" \"expo start --web\"",
    "db:reset": "node scripts/prepare-db.mjs --reset",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:web": "expo export --platform web",
    "test": "vitest run",
    "serve:web": "node scripts/serve-dist.mjs",
    "test:e2e": "node tests/e2e/flow.mjs",
    "media:readme": "node tests/e2e/readme-media.mjs"
  }
}
